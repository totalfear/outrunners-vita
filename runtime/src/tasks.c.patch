 }
+
+void host_task_switch(host_task *to)
+{
+	host_task *from = current;
+
+	if (to == from)
+		return;
+	current = to;
+	host_switch_stacks(&from->stack_pointer, to->stack_pointer);
+}
+
+#elif defined(__vita__)
+
+/* The Vita (ARMv7, hard float): newlib has no ucontext, so a task's registers are kept on its own stack, as on
+   the aarch64 targets above. What a call keeps for its caller (AAPCS: r4-r11, lr, d8-d15) is pushed where the
+   task stops and popped where it goes on; r3 is pushed only to keep the stack pointer 8-byte aligned. */
+#define SAVED_BYTES 104    /* d8-d15 (64) + r3-r11 (36) + lr (4) */
+#define SAVED_LR_WORD 25   /* lr's place among the 32-bit words from the stack pointer: byte 100 */
+
+void host_switch_stacks(void **from_stack, void *to_stack);
+
+__asm__(
+	".text\n"
+	".arm\n"
+	".global host_switch_stacks\n"
+	".type host_switch_stacks, %function\n"
+	"host_switch_stacks:\n"
+	"	push {r3-r11, lr}\n"
+	"	vpush {d8-d15}\n"
+	"	str sp, [r0]\n"
+	"	mov sp, r1\n"
+	"	vpop {d8-d15}\n"
+	"	pop {r3-r11, lr}\n"
+	"	bx lr\n"
+	".size host_switch_stacks, .-host_switch_stacks\n");
+
+struct host_task
+{
+	void *stack_pointer;    /* where it stopped: its registers on top */
+	void *stack;
+	void (*start)(void);
+};
+
+static host_task main_task;
+static host_task *current;
+static unsigned tasks_made;
+
+host_task *host_task_main(void)
+{
+	if (!current)
+		current = &main_task;
+	return &main_task;
+}
+
+static void run_task(void)
+{
+	current->start();
+	fprintf(stderr, "A task came to its end\n");
+	exit(3);
+}
+
+host_task *host_task_create(void (*start)(void))
+{
+	host_task *task = calloc(1, sizeof(*task));
+	uint32_t *registers;
+
+	if (task)
+		task->stack = malloc(TASK_STACK_SIZE);
+	if (!task || !task->stack)
+	{
+		fprintf(stderr, "A task could not be created (%u made, %u KB each)\n", tasks_made, TASK_STACK_SIZE >> 10);
+		exit(3);
+	}
+	tasks_made++;
+	fprintf(stderr, "task %u: %u KB of stack\n", tasks_made, TASK_STACK_SIZE >> 10);    /* (to size TASK_STACK_SIZE by) */
+	task->start = start;
+	/* its first switch pops registers that return into run_task, at the top of its stack (8-byte aligned) */
+	registers = (uint32_t *)(((uintptr_t)task->stack + TASK_STACK_SIZE - SAVED_BYTES) & ~(uintptr_t)7);
+	memset(registers, 0, SAVED_BYTES);
+	registers[SAVED_LR_WORD] = (uint32_t)(uintptr_t)run_task;    /* (lr: where the first bx lr goes; the function pointer carries the Thumb bit if it needs it) */
+	task->stack_pointer = registers;
+	return task;
+}
 
