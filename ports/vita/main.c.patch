+#ifdef __vita__
+static SDL_AudioStream *audio_resampler;    /* the mix's rate to the 48000 Hz the Vita's audio takes, when it does not take it */
+#endif
+
+/* The mix to the device's queue (through the resampler on the Vita, when there is one) */
+static void queue_audio(const void *data, Uint32 bytes)
+{
+#ifdef __vita__
+	if (audio_resampler)
+	{
+		Uint8 converted[8192];
+		int got;
+
+		if (SDL_AudioStreamPut(audio_resampler, data, (int)bytes) == 0)
+			while ((got = SDL_AudioStreamGet(audio_resampler, converted, sizeof(converted))) > 0)
+				SDL_QueueAudio(audio, converted, (Uint32)got);
+		return;
+	}
+#endif
+	SDL_QueueAudio(audio, data, bytes);
+}
